;;; org-anki-test.el --- Import and synchronization tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'org-anki)

(defconst org-anki-test--json
  '((noteId . 1234567890123)
    (modelName . "Custom")
    (tags . ["study"])
    (fields . ((Third (value . "") (order . 2))
               (Question (value . "Question text") (order . 0))
               (Answer (value . "Answer text") (order . 1))))))

(ert-deftest org-anki-import-discovers-ordered-fields ()
  (let ((org-anki-model-fields nil)
        (org-anki-html-to-org #'identity))
    (cl-letf (((symbol-function 'org-anki-connect-request)
               (lambda (&rest _) (ert-fail "Import must use notesInfo fields"))))
      (let ((note (org-anki--parse-note org-anki-test--json "Deck")))
        (should (equal (org-anki--note-fields note)
                       '(("Question" . "Question text")
                         ("Answer" . "Answer text") ("Third" . ""))))
        (with-temp-buffer
          (org-mode)
          (org-anki--write-note note)
          (goto-char (point-min))
          (should (equal (org-entry-get nil "ITEM") "1234567890123"))
          (should (equal (org-entry-get nil "ANKI_NOTE_ID") "1234567890123"))
          (should (equal (org-entry-get nil "ANKI_NOTE_TYPE") "Custom"))
          (should (equal (org-get-tags) '("study")))
          (should (equal (org-map-entries (lambda () (org-entry-get nil "ITEM")))
                         '("1234567890123" "Question" "Answer" "Third"))))))))

(ert-deftest org-anki-import-basic-always-uses-field-headings ()
  (with-temp-buffer
    (org-mode)
    (org-anki--write-note
     (make-org-anki--note :maybe-id 42 :type "Basic"
                          :fields '(("Front" . "one line") ("Back" . ""))))
    (goto-char (point-min))
    (should (equal (org-entry-get nil "ANKI_NOTE_TYPE") "Basic"))
    (should (equal (org-map-entries (lambda () (org-entry-get nil "ITEM")))
                   '("42" "Front" "Back")))))

(ert-deftest org-anki-model-fields-query-and-cache ()
  (let ((org-anki-model-fields '(("Custom" "Incorrect")))
        (org-anki--model-fields-cache nil)
        (calls 0))
    (cl-letf (((symbol-function 'org-anki-connect-request)
               (lambda (body success _error &rest options)
                 (cl-incf calls)
                 (should (equal body '(("action" . "modelFieldNames")
                                       ("params" ("modelName" . "Custom")))))
                 (should (plist-get options :sync))
                 (funcall success ["Question" "Answer" "Third"]))))
      (dotimes (_ 2)
        (should (equal (org-anki--get-model-fields "Custom")
                       '("Question" "Answer" "Third"))))
      (should (= calls 1)))))

(ert-deftest org-anki-model-fields-propagates-api-error ()
  (let ((org-anki--model-fields-cache nil))
    (cl-letf (((symbol-function 'org-anki-connect-request)
               (lambda (_body _success failure &rest _)
                 (funcall failure "Model not found"))))
      (should-error (org-anki--get-model-fields "Missing")))))

(ert-deftest org-anki-imported-custom-note-round-trips ()
  (let ((org-anki-model-fields nil)
        (org-anki-html-to-org #'identity)
        (org-anki--model-fields-cache nil))
    (cl-letf (((symbol-function 'org-anki-connect-request)
               (lambda (_body success _failure &rest _)
                 (funcall success ["Question" "Answer" "Third"])))
              ((symbol-function 'org-anki--org-to-html) #'string-trim))
      (with-temp-buffer
        (org-mode)
        (insert "#+ANKI_DECK: Deck\n\n")
        (org-anki--write-note (org-anki--parse-note org-anki-test--json "Deck"))
        (goto-char (point-min))
        (outline-next-heading)
        (let ((note (org-anki--note-at-point)))
          (should (= (org-anki--note-maybe-id note) 1234567890123))
          (should (equal (org-anki--note-type note) "Custom"))
          (dolist (field '(("Question" . "Question text")
                           ("Answer" . "Answer text") ("Third" . "")))
            (should (equal (cdr (assoc (car field) (org-anki--note-fields note)))
                           (cdr field)))))))))

(ert-deftest org-anki-sync-all-skips-field-subtrees-and-refreshes-models ()
  (let ((org-anki-model-fields nil)
        (org-anki-html-to-org #'identity)
        (calls 0) collected)
    (cl-letf (((symbol-function 'org-anki-connect-request)
               (lambda (_body success _failure &rest _)
                 (cl-incf calls)
                 (funcall success ["Question" "Answer" "Third"])))
              ((symbol-function 'org-anki--org-to-html) #'string-trim)
              ((symbol-function 'org-anki--sync-notes)
               (lambda (notes) (setq collected notes))))
      (with-temp-buffer
        (org-mode)
        (insert "#+ANKI_DECK: Deck\n\n")
        (dotimes (_ 2)
          (org-anki--write-note (org-anki--parse-note org-anki-test--json "Deck")))
        (org-anki-sync-all)
        (should (= (length collected) 2))
        (should (= calls 1))
        (org-anki-update-all)
        (should (= (length collected) 2))
        (should (= calls 2))))))

(ert-deftest org-anki-import-retains-destination-across-callbacks ()
  (let ((org-anki-html-to-org #'identity) callbacks)
    (cl-letf (((symbol-function 'org-anki-connect-request)
               (lambda (_body success _failure &rest _)
                 (push success callbacks))))
      (with-temp-buffer
        (org-mode)
        (let ((destination (current-buffer)))
          (org-anki-import-deck "Deck" destination)
          (with-temp-buffer
            (funcall (pop callbacks) [1234567890123])
            (funcall (pop callbacks) (vector org-anki-test--json))
            (should (string-empty-p (buffer-string))))
          (should (string-match-p "^\\* 1234567890123" (buffer-string))))))))

(ert-deftest org-anki-cloze-fields-round-trip-with-html-export ()
  (let ((org-anki-model-fields nil)
        (org-anki--model-fields-cache nil)
        (org-anki-media-method 'http))
    (cl-letf (((symbol-function 'org-anki-connect-request)
               (lambda (_body success _failure &rest _)
                 (funcall success ["Text" "Extra"]))))
      (with-temp-buffer
        (org-mode)
        (insert "#+ANKI_DECK: Deck\n\n")
        (org-anki--write-note
         (make-org-anki--note :maybe-id 42 :type "Cloze"
                              :fields '(("Text" . "A {{c1::cloze}}")
                                        ("Extra" . "Extra text"))))
        (goto-char (point-min))
        (outline-next-heading)
        (let* ((note (org-anki--note-at-point))
               (fields (org-anki--note-fields note)))
          (should (equal (org-anki--note-type note) "Cloze"))
          (should (string-match-p "{{c1::cloze}}" (cdr (assoc "Text" fields))))
          (should (string-match-p "Extra text" (cdr (assoc "Extra" fields)))))))))

(ert-deftest org-anki-field-content-headings-stay-in-field ()
  (let ((content "* Heading\nBody\n** Child\n#+begin_src org\n,* literal\n#+end_src"))
    (with-temp-buffer
      (org-mode)
      (org-anki--write-note
       (make-org-anki--note :maybe-id 42 :type "Basic"
                            :fields `(("Front" . ,content) ("Back" . "Answer"))))
      (should (equal (org-map-entries (lambda () (org-current-level)))
                     '(1 2 3 4 2)))
      (should (string-match-p "^,\\* literal$" (buffer-string))))))

(ert-deftest org-anki-import-converts-html-with-pandoc ()
  (skip-unless (executable-find "pandoc"))
  (let ((org-anki-html-to-org #'org-anki--html-to-org-via-tempfile))
    (with-temp-buffer
      (org-mode)
      (org-anki--write-note
       (org-anki--parse-note
        '((noteId . 42) (modelName . "Basic")
          (fields . ((Front (value . "<h1>Heading</h1><p>Some <strong>bold</strong> text</p>")
                            (order . 0))
                     (Back (value . "") (order . 1)))))
        "Deck"))
      (should (equal (org-map-entries (lambda () (org-current-level))) '(1 2 3 2)))
      (should (string-match-p "Some \\*bold\\* text" (buffer-string))))))
